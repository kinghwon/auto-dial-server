# ── 서버 기본 설정 ──────────────────────────────────────────────
# 서버가 열릴 주소/포트 (0.0.0.0 은 같은 와이파이의 폰에서 접속 가능)
HOST=0.0.0.0
PORT=8000

# 시간대 (스케줄 계산 기준)
APP_TZ=Asia/Seoul

# 데이터(DB) 저장 위치
# DATA_DIR=./data
# DB_PATH=./data/autodialer.db

# 대시보드/앱 공통 인증 키.
# 비워두면 인증 없이 동작합니다(집 안 와이파이에서만 쓸 때).
# 인터넷에 포트를 열었다면 반드시 길게 설정하고, 앱의 "API 키" 칸에도 같은 값을 넣으세요.
SERVER_API_KEY=

# 기기 오프라인 판정 시간(초)
ONLINE_TIMEOUT_SEC=90

# 스케줄 확인 주기(초)
SCHEDULER_INTERVAL_SEC=10

# 기기가 가져간 작업을 회수하기까지의 시간(초)
TASK_TIMEOUT_SEC=900

# 앱이 서버에 묻는 기본 주기(초)
DEFAULT_POLL_INTERVAL_SEC=5

# 텔레그램 전송 재시도 횟수
TELEGRAM_MAX_ATTEMPTS=3
